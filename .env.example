# ---- Database ----
# PostgreSQL connection string (used by api, worker, and db package)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bespoke

# ---- Redis (Upstash) ----
# Use the Upstash TCP endpoint (rediss://...), NOT the REST URL.
# BullMQ requires a persistent TCP connection via ioredis.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

# ---- AI (OpenRouter via Vercel AI SDK) ----
# The Vercel AI SDK needs no key of its own — only OpenRouter.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ---- Scraping (Firecrawl) ----
FIRECRAWL_API_KEY=fc-...

# ---- Web (browser-exposed) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
