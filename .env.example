# ---- Database ----
# PostgreSQL connection string (used by api, worker, and db package)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bespoke

# ---- Redis (Upstash) ----
# Use the Upstash TCP endpoint (rediss://...), NOT the REST URL.
# BullMQ requires a persistent TCP connection via ioredis.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

# ---- AI (OpenRouter via Vercel AI SDK) ----
# The Vercel AI SDK needs no key of its own — only OpenRouter.
OPENROUTER_API_KEY=sk-or-...
# Model for scrape/vision extraction. Message-generation model is per-user
# (Settings page) and defaults to google/gemini-3.5-flash.
OPENROUTER_MODEL=anthropic/claude-sonnet-latest

# ---- Scraping (Firecrawl) ----
FIRECRAWL_API_KEY=fc-...

# Optional: GitHub user/repo URLs are fetched via the GitHub REST API instead
# of Firecrawl. A token raises the rate limit from 60 to 5000 req/hr.
GITHUB_TOKEN=ghp_...

# ---- File Storage (Cloudinary) ----
# API signs uploads; the browser uploads files direct to Cloudinary.
# The API secret stays server-side (api + worker) — never exposed to the web.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# ---- Web (browser-exposed) ----
# Cloudinary cloud name is returned by the sign endpoint, so the web app
# needs no Cloudinary env of its own.
NEXT_PUBLIC_API_URL=http://localhost:3001
