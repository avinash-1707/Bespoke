{
  "name": "@bespoke/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "pnpm exec dotenv -e ../../.env -- drizzle-kit generate",
    "migrate": "pnpm exec dotenv -e ../../.env -- drizzle-kit migrate",
    "studio": "pnpm exec dotenv -e ../../.env -- drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@bespoke/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^6.0.0"
  }
}
